# Copy to .env.local and fill in values from your Supabase project settings.
# The two NEXT_PUBLIC_* keys are safe to expose to the browser — RLS is
# forced on every table. Everything else is server/edge-function only.
#
# ─── Required for the Next.js app (web/.env.local) ──────────────────────
# Supabase Studio → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase Studio → Settings → API → "anon" / "public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ─── Required for Supabase Edge Functions (NOT web/.env.local) ──────────
# These are set in Supabase Studio → Project Settings → Edge Functions →
# Secrets. They are NEVER read by the Next.js app. Listed here as a
# checklist so a fresh deploy knows what edge-function secrets to populate.
#
# SUPABASE_URL=                  # same value as NEXT_PUBLIC_SUPABASE_URL above
# SUPABASE_SERVICE_ROLE_KEY=     # Studio → API → "service_role" (NEVER ship to browser)
# ANTHROPIC_API_KEY=             # https://console.anthropic.com — used by AIQ + memo routines
# FMP_API_KEY=                   # https://site.financialmodelingprep.com — fundamentals + prices
# POLYGON_API_KEY=               # https://polygon.io — backup price/data source
# CRON_INVOKE_SECRET=            # arbitrary bearer for scheduled-job auth — generate w/ `openssl rand -hex 32`
